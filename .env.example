# Environment (development | production | test)
APP_ENV=development

# Primary database — used by the API and `alembic upgrade head`.
# For docker-compose, use: postgresql+psycopg://postgres:postgres@db:5432/meet_scheduler
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/meet_scheduler

# Test database — only read by pytest. Must end in `meet_scheduler_test`
# or tests will refuse to run (safety guard in tests/conftest.py).
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/meet_scheduler_test

# HS256 signing secret for JWT access + refresh tokens. Use a long random string in production.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
TOKEN_SECRET=change-me-in-development-replace-with-a-long-random-secret
